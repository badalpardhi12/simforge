# ── Direct RTDE Robot Controller ─────────────────────────────
# Bypasses the entire ROS2 control stack (UR driver, ros2_control,
# scaled_joint_trajectory_controller) and communicates directly with
# the UR controller via RTDE protocol.
#
# Approach: stream cuRobo waypoints using servoJ() at ~500Hz for
# smooth, glitch-free trajectory execution on real hardware.

class URRTDEController:
    """Direct RTDE connection to a UR robot for real-time trajectory streaming.

    Uses ur_rtde library:
      - RTDEControlInterface: send servoJ/moveJ commands
      - RTDEReceiveInterface: read actual joint positions/velocities

    The servoJ approach streams individual joint targets at 500Hz,
    giving us complete control over the trajectory and avoiding all
    the timing/interpolation issues of the ROS2 control stack.
    """

    def __init__(self, robot_name: str, ip: str, logger=None):
        self.robot_name = robot_name
        self.ip = ip
        self.logger = logger
        self._ctrl: Optional[Any] = None
        self._recv: Optional[Any] = None
        self._connected = False
        self._frequency = 500.0  # Hz — UR e-series native RTDE rate
        self._dt = 1.0 / self._frequency

    def connect(self) -> bool:
        """Establish RTDE control and receive connections."""
        if self.is_connected:
            if self.logger:
                self.logger.info(f"RTDE already connected to {self.robot_name}")
            return True
        if not RTDE_AVAILABLE:
            if self.logger:
                self.logger.error(f"ur_rtde not installed — cannot connect to {self.robot_name}")
            return False
        try:
            if self.logger:
                self.logger.info(f"Connecting RTDE to {self.robot_name} at {self.ip}...")

            self._recv = rtde_receive.RTDEReceiveInterface(self.ip)
            self._ctrl = rtde_control.RTDEControlInterface(self.ip)

            self._connected = True
            if self.logger:
                self.logger.info(f"RTDE connected to {self.robot_name} at {self.ip} ✓")
            return True
        except Exception as e:
            if self.logger:
                self.logger.error(f"RTDE connection failed for {self.robot_name} at {self.ip}: {e}")
            self._connected = False
            return False

    def disconnect(self):
        """Cleanly disconnect RTDE interfaces."""
        try:
            if self._ctrl:
                self._ctrl.servoStop()
                self._ctrl.stopScript()
                self._ctrl.disconnect()
        except Exception:
            pass
        try:
            if self._recv:
                self._recv.disconnect()
        except Exception:
            pass
        self._connected = False
        self._ctrl = None
        self._recv = None
        if self.logger:
            self.logger.info(f"RTDE disconnected from {self.robot_name}")

    @property
    def is_connected(self) -> bool:
        """Check if RTDE interfaces are active.

        Uses the internal _connected flag — the ur_rtde isConnected()
        can return False transiently during async operations or after
        servoStop, even though the connection is still usable.
        """
        return self._connected and self._ctrl is not None and self._recv is not None

    def get_actual_q(self) -> Optional[List[float]]:
        """Read actual joint positions from the robot."""
        if not self.is_connected:
            return None
        try:
            return list(self._recv.getActualQ())
        except Exception as e:
            if self.logger:
                self.logger.error(f"RTDE getActualQ failed: {e}")
            return None

    def get_actual_qd(self) -> Optional[List[float]]:
        """Read actual joint velocities from the robot."""
        if not self.is_connected:
            return None
        try:
            return list(self._recv.getActualQd())
        except Exception:
            return None

    def move_j(self, target_q: List[float], speed: float = 1.05,
               acceleration: float = 1.4, timeout: float = 30.0) -> bool:
        """Move to joint position using moveJ (blocking with timeout).

        Good for large motions like going home.  The UR controller
        handles the interpolation internally — very reliable.
        Timeout prevents indefinite blocking if the controller hangs.
        """
        if not self.is_connected:
            return False
        try:
            # Reconnect control interface if needed (e.g. after servoStop)
            if not self._ctrl.isConnected():
                if self.logger:
                    self.logger.info(f"RTDE ctrl reconnecting for moveJ on {self.robot_name}")
                import threading
                rc_thread = threading.Thread(
                    target=lambda: self._ctrl.reconnect(), daemon=True
                )
                rc_thread.start()
                rc_thread.join(timeout=5.0)
                if rc_thread.is_alive():
                    if self.logger:
                        self.logger.warn(f"RTDE reconnect timed out for moveJ on {self.robot_name}")
                    return False

            if self.logger:
                self.logger.info(
                    f"RTDE moveJ {self.robot_name}: "
                    f"speed={speed:.2f}, accel={acceleration:.2f}"
                )

            # Run moveJ in a thread with timeout to prevent indefinite blocking
            import threading
            result_holder = [False]
            exc_holder = [None]

            def _do_move():
                try:
                    self._ctrl.moveJ(target_q, speed, acceleration)
                    result_holder[0] = True
                except Exception as e:
                    exc_holder[0] = e

            t = threading.Thread(target=_do_move, daemon=True)
            t.start()
            t.join(timeout=timeout)

            if t.is_alive():
                if self.logger:
                    self.logger.warn(
                        f"RTDE moveJ timed out after {timeout}s on {self.robot_name}"
                    )
                try:
                    self._ctrl.stopJ(2.0)
                except Exception:
                    pass
                return False

            if exc_holder[0]:
                raise exc_holder[0]

            return result_holder[0]
        except Exception as e:
            if self.logger:
                self.logger.error(f"RTDE moveJ failed: {e}")
            return False

    def execute_trajectory_servoj(
        self,
        positions: list,
        velocities: Optional[list] = None,
        dt: float = 0.002,
        timestamps: Optional[list] = None,
        lookahead_time: float = 0.1,
        gain: int = 300,
        stop_check_fn=None,
        logger=None,
    ) -> bool:
        """Stream a trajectory using servoJ at the robot's native RTDE rate.

        The trajectory is upsampled via linear interpolation to the RTDE
        servo rate (500Hz) to ensure smooth motion.  When *timestamps* is
        provided the interpolation respects per-waypoint timing (including
        dwell pauses); otherwise a uniform *dt* is assumed.

        Parameters
        ----------
        positions : list of list of float
            Joint position waypoints (n_pts × 6).
        velocities : optional, not used by servoJ but kept for interface compat.
        dt : float
            Uniform time step between waypoints (used only when *timestamps*
            is None).
        timestamps : list of float, optional
            Per-waypoint time-from-start in seconds.  When given, *dt* is
            ignored and the timestamps are used directly, which correctly
            preserves dwell pauses embedded in the trajectory.
        lookahead_time : float
            servoJ lookahead [0.03..0.2].  Higher = smoother but more lag.
        gain : int
            servoJ proportional gain [100..2000].  Higher = stiffer tracking.
        stop_check_fn : callable, optional
            Returns True if we should abort (e.g. proto_sim_stop).
        logger : optional
            ROS2 logger for status messages.
        """
        if not self.is_connected:
            if logger:
                logger.error(f"RTDE not connected to {self.robot_name}")
            return False

        n_pts = len(positions)
        if n_pts < 2:
            if logger:
                logger.warn(f"Trajectory too short ({n_pts} points)")
            return True

        # Build per-waypoint timestamp array
        if timestamps is not None:
            wp_times = list(timestamps)
        else:
            wp_times = [i * dt for i in range(n_pts)]

        # Upsample trajectory to 500Hz (servo_dt = 0.002s)
        servo_dt = self._dt
        total_time = wp_times[-1]
        n_servo = int(total_time / servo_dt) + 1

        if logger:
            logger.info(
                f"RTDE servoJ streaming {self.robot_name}: "
                f"{n_pts} waypoints → "
                f"{n_servo} servo commands @ {self._frequency:.0f}Hz, "
                f"duration={total_time:.2f}s"
            )

        try:
            # Pre-compute a segment-index cursor so lookup is O(1) amortised
            seg_idx = 0

            for si in range(n_servo):
                if stop_check_fn and stop_check_fn():
                    if logger:
                        logger.info(f"RTDE servoJ aborted by stop request")
                    self._ctrl.servoStop()
                    return False

                t = si * servo_dt

                # Advance segment cursor to the right interval
                while (seg_idx < n_pts - 2 and
                       wp_times[seg_idx + 1] <= t):
                    seg_idx += 1

                idx0 = seg_idx
                idx1 = min(idx0 + 1, n_pts - 1)

                seg_dur = wp_times[idx1] - wp_times[idx0]
                if seg_dur > 0:
                    alpha = (t - wp_times[idx0]) / seg_dur
                    alpha = max(0.0, min(1.0, alpha))
                else:
                    alpha = 1.0

                # Linear interpolation between waypoints
                q_target = [
                    positions[idx0][j] * (1.0 - alpha) + positions[idx1][j] * alpha
                    for j in range(6)
                ]

                # Send servoJ command
                t_start = self._ctrl.initPeriod()
                self._ctrl.servoJ(
                    q_target,
                    0.0,   # speed (not used)
                    0.0,   # acceleration (not used)
                    servo_dt,
                    lookahead_time,
                    gain,
                )
                self._ctrl.waitPeriod(t_start)

            # Stop servo mode cleanly
            self._ctrl.servoStop()
            import time as _time
            _time.sleep(0.5)  # Let controller settle after servo stop

            # After servoStop, the control interface may need reconnection
            # for subsequent moveJ calls.  Try reconnect with a timeout
            # so we never block indefinitely.
            import threading
            def _try_reconnect():
                try:
                    if not self._ctrl.isConnected():
                        self._ctrl.reconnect()
                except Exception:
                    pass

            rc_thread = threading.Thread(target=_try_reconnect, daemon=True)
            rc_thread.start()
            rc_thread.join(timeout=5.0)  # Max 5s to reconnect
            if rc_thread.is_alive():
                if logger:
                    logger.warn(f"RTDE reconnect timed out for {self.robot_name} — will reconnect later")

            if logger:
                logger.info(f"RTDE servoJ complete for {self.robot_name} ✓")
            return True

        except Exception as e:
            if logger:
                logger.error(f"RTDE servoJ error on {self.robot_name}: {e}")
            try:
                self._ctrl.servoStop()
            except Exception:
                pass
            return False

    def is_at_position(self, target_q: List[float], tolerance: float = 0.05) -> bool:
        """Check if robot is at the given joint position."""
        actual = self.get_actual_q()
        if actual is None:
            return False
        return all(abs(actual[i] - target_q[i]) < tolerance for i in range(6))


