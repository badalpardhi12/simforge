<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simforge_gateway_nvidia</name>
  <version>1.0.0</version>
  <description>
    WebSocket gateway for simforge client communication with ROS2,
    using NVIDIA cuRobo for GPU-accelerated motion planning.
    Replaces MoveIt2 with cuRobo MotionGen / IKSolver.
  </description>
  <maintainer email="badal@example.com">Badal</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- NOTE: no moveit_msgs dependency — cuRobo replaces MoveIt -->

  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-torch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
