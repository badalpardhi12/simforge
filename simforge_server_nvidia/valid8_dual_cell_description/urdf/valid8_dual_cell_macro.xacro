<?xml version="1.0"?>
<!--
Valid8 Dual Robot Cell Macro

This macro defines the Valid8 workcell environment with TWO UR5e robots:
- Shop floor, optical table, face fixture
- nakul_ur5e: Position [-0.6758, 0, 1.03] with -90° yaw
- sahadev_ur5e: Position [0.6758, 0, 1.03] with +90° yaw

Both robots are UR5e with iPhone tools attached.

Based on Universal Robots ROS2 Dual Robot Tutorial.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="valid8_dual_cell" params="parent
    nakul_ur_type nakul_joint_limits_parameters_file nakul_kinematics_parameters_file 
    nakul_physical_parameters_file nakul_visual_parameters_file
    sahadev_ur_type sahadev_joint_limits_parameters_file sahadev_kinematics_parameters_file 
    sahadev_physical_parameters_file sahadev_visual_parameters_file
    *origin">
    
    <!-- ================================================================ -->
    <!-- Shop Floor - Ground plane at z=0                                 -->
    <!-- ================================================================ -->
    <link name="shop_floor">
      <visual>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <box size="5.0 5.0 0.1"/>
        </geometry>
        <material name="floor_gray">
          <color rgba="0.4 0.4 0.4 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <box size="5.0 5.0 0.1"/>
        </geometry>
      </collision>
    </link>
    
    <joint name="${parent}_to_shop_floor" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="shop_floor"/>
    </joint>
    
    <!-- ================================================================ -->
    <!-- Optical Table - Main workspace surface at z=1.0m                 -->
    <!-- ================================================================ -->
    <link name="table_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://valid8_dual_cell_description/meshes/optical_table.dae" scale="1.4 1.37 1.17"/>
        </geometry>
        <material name="table_black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.5" rpy="0 0 0"/>
        <geometry>
          <box size="2.1 1.1 1.04"/>
        </geometry>
      </collision>
    </link>
    
    <joint name="floor_to_table" type="fixed">
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <parent link="shop_floor"/>
      <child link="table_link"/>
    </joint>
    
    <!-- ================================================================ -->
    <!-- Face Fixture - Test subject mount                                -->
    <!-- Position: [0.1742, 0, 1.6] with 90° yaw                          -->
    <!-- ================================================================ -->
    <link name="face_link">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://valid8_dual_cell_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin">
          <color rgba="0.92 0.76 0.65 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry>
          <sphere radius="0.1"/>
        </geometry>
      </collision>
    </link>
    
    <joint name="floor_to_face" type="fixed">
      <origin xyz="0.1742 0 1.6" rpy="0 0 1.5708"/>
      <parent link="shop_floor"/>
      <child link="face_link"/>
    </joint>
    
    <!-- ================================================================ -->
    <!-- NAKUL Robot Mount                                                -->
    <!-- Position: [-0.6758, 0, 1.03] with -90° yaw (-1.5708 rad)         -->
    <!-- ================================================================ -->
    <link name="nakul_robot_mount"/>
    
    <joint name="floor_to_nakul_robot_mount" type="fixed">
      <origin xyz="-0.6758 0 1.03" rpy="0 0 -1.5708"/>
      <parent link="shop_floor"/>
      <child link="nakul_robot_mount"/>
    </joint>
    
    <!-- ================================================================ -->
    <!-- SAHADEV Robot Mount                                              -->
    <!-- Position: [0.6758, 0, 1.03] with +90° yaw (1.5708 rad)           -->
    <!-- ================================================================ -->
    <link name="sahadev_robot_mount"/>
    
    <joint name="floor_to_sahadev_robot_mount" type="fixed">
      <origin xyz="0.6758 0 1.03" rpy="0 0 1.5708"/>
      <parent link="shop_floor"/>
      <child link="sahadev_robot_mount"/>
    </joint>
    
    <!-- ================================================================ -->
    <!-- NAKUL UR5e Robot (first robot)                                   -->
    <!-- tf_prefix: nakul_ to distinguish from sahadev                    -->
    <!-- generate_ros2_control_tag: false - controlled URDF adds this     -->
    <!-- ================================================================ -->
    <xacro:ur_robot
      name="nakul_ur5e"
      tf_prefix="nakul_"
      parent="nakul_robot_mount"
      joint_limits_parameters_file="${nakul_joint_limits_parameters_file}"
      kinematics_parameters_file="${nakul_kinematics_parameters_file}"
      physical_parameters_file="${nakul_physical_parameters_file}"
      visual_parameters_file="${nakul_visual_parameters_file}"
      generate_ros2_control_tag="false"
    >
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot>
    
    <!-- ================================================================ -->
    <!-- SAHADEV UR5e Robot (second robot)                                -->
    <!-- tf_prefix: sahadev_ to distinguish from nakul                    -->
    <!-- generate_ros2_control_tag: false - controlled URDF adds this     -->
    <!-- ================================================================ -->
    <xacro:ur_robot
      name="sahadev_ur5e"
      tf_prefix="sahadev_"
      parent="sahadev_robot_mount"
      joint_limits_parameters_file="${sahadev_joint_limits_parameters_file}"
      kinematics_parameters_file="${sahadev_kinematics_parameters_file}"
      physical_parameters_file="${sahadev_physical_parameters_file}"
      visual_parameters_file="${sahadev_visual_parameters_file}"
      generate_ros2_control_tag="false"
    >
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot>
    
    <!-- ================================================================ -->
    <!-- NAKUL iPhone Tool                                                -->
    <!-- Attached to nakul_wrist_3_link                                   -->
    <!-- ================================================================ -->
    <link name="nakul_tool_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 3.14"/>
        <geometry>
          <mesh filename="package://valid8_dual_cell_description/meshes/iphone.stl" scale="0.04 0.04 0.04"/>
        </geometry>
        <material name="iphone_gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.065 0 0.02" rpy="1.5708 0 0"/>
        <geometry>
          <box size="0.3 0.13 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    
    <link name="nakul_tool_tip_link"/>
    
    <joint name="nakul_wrist_3_to_tool" type="fixed">
      <!-- Tool attached to wrist_3_link with offset matching the old server:
           xyz='-0.08 0 0.05' rpy='1.57 0 0' (90° X rotation).
           The 90° X rotation is required because the client's _look_at_quaternion
           generates Y-axis as the tool-forward direction, and this rotation
           maps tool_tip_link's frame so Y-axis aligns with the physical
           iPhone pointing direction. -->
      <origin xyz="-0.08 0 0.01" rpy="1.57 0 0"/>
      <parent link="nakul_wrist_3_link"/>
      <child link="nakul_tool_base_link"/>
    </joint>
    
    <joint name="nakul_tool_base_to_tip" type="fixed">
      <parent link="nakul_tool_base_link"/>
      <child link="nakul_tool_tip_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
  </xacro:macro>

</robot>
