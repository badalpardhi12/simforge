<?xml version="1.0"?>
<!--
Valid8 Dual Robot Cell Controlled URDF

This URDF extends the description with ros2_control tags for both robots.
Each robot has its own hardware interface (real or mock).

Based on Universal Robots ROS2 Dual Robot Tutorial.

Uses a patched version of ur.ros2_control.xacro that exposes servoj_gain
and servoj_lookahead_time as configurable parameters (upstream hardcodes
them).  Tuned values for non-RT dual-robot system:
  servoj_gain=750         (default 2000): soft position tracking that
                          absorbs spline interpolation acceleration
                          discontinuities.  The controller sends position
                          commands at 500Hz via servoj — high gain
                          amplifies every discontinuity into a physical
                          jerk.  750 gives smooth tracking without
                          feeling sluggish.  Range tested: 1000 still
                          jerky, 500 too sluggish, 750 is the sweet spot.
  servoj_lookahead_time=0.2  (default 0.03, max 0.2): maximum smoothing
                          window.  servoj internally smooths the position
                          command stream — higher lookahead = more
                          smoothing.  0.2s (max) is ideal for non-RT
                          systems where timing jitter from the ROS
                          control loop is significant.
  keep_alive_count=50     (default 2): ~100ms grace period at 500Hz. The
                          default of 2 causes frequent reverse-interface
                          drops on non-RT systems under scheduler jitter,
                          which cascades into controller_stopper
                          deactivating trajectory controllers mid-motion.
-->
<robot name="valid8_dual_cell" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Include base description -->
  <xacro:include filename="$(find valid8_dual_cell_description)/urdf/valid8_dual_cell.urdf.xacro"/>
  
  <!-- Include PATCHED UR ros2_control macro with configurable servoj params -->
  <xacro:include filename="$(find valid8_dual_cell_control)/urdf/ur_ros2_control_patched.xacro"/>

  <!-- ========== ros2_control Arguments for Nakul ========== -->
  <xacro:arg name="nakul_robot_ip" default="192.168.1.9"/>
  <xacro:arg name="nakul_use_fake_hardware" default="false"/>
  <xacro:arg name="nakul_fake_sensor_commands" default="false"/>
  <xacro:arg name="nakul_hash_kinematics" default="calib_12788084448423163542"/>
  
  <!-- ========== ros2_control Arguments for Sahadev ========== -->
  <xacro:arg name="sahadev_robot_ip" default="192.168.1.16"/>
  <xacro:arg name="sahadev_use_fake_hardware" default="false"/>
  <xacro:arg name="sahadev_fake_sensor_commands" default="false"/>
  <xacro:arg name="sahadev_hash_kinematics" default="calib_12788084448423163542"/>
  
  <!-- ========== Common Arguments ========== -->
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="script_filename" default="$(find ur_robot_driver)/resources/ros_control.urscript"/>
  <xacro:arg name="output_recipe_filename" default="$(find ur_robot_driver)/resources/rtde_output_recipe.txt"/>
  <xacro:arg name="input_recipe_filename" default="$(find ur_robot_driver)/resources/rtde_input_recipe.txt"/>

  <!-- ========== Nakul ros2_control Hardware Interface ========== -->
  <!-- Nakul uses default UR ports: 50001-50004 -->
  <!--
    keep_alive_count: Number of control-loop cycles without data before
    the URScript program on the robot exits.  Set to 50 (~100 ms grace
    at 500 Hz).  The default of 2 is far too aggressive for non-RT
    dual-robot setups — scheduler jitter on non-RT Linux can easily
    cause >20 ms gaps between successive servoj commands.

    servoj_gain: Proportional gain for servoj (range 100-3000).
    Default 2000 is maximum stiffness — amplifies every acceleration
    discontinuity from the spline interpolator into a physical jerk.
    750 provides smooth tracking that absorbs spline boundary effects.

    servoj_lookahead_time: Lookahead window for servoj (range 0.03-0.2).
    Default 0.03s gives almost no smoothing.  0.2s (maximum) gives
    the internal servoj PD controller maximum smoothing, essential for
    non-RT systems where the 500Hz command stream has timing jitter.
  -->
  <xacro:ur_ros2_control_patched
    name="nakul_ur5e"
    tf_prefix="nakul_"
    robot_ip="$(arg nakul_robot_ip)"
    use_fake_hardware="$(arg nakul_use_fake_hardware)"
    fake_sensor_commands="$(arg nakul_fake_sensor_commands)"
    hash_kinematics="$(arg nakul_hash_kinematics)"
    headless_mode="$(arg headless_mode)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    reverse_port="50001"
    script_sender_port="50002"
    trajectory_port="50003"
    script_command_port="50004"
    keep_alive_count="50"
    servoj_gain="750"
    servoj_lookahead_time="0.2"
  />

  <!-- ========== Sahadev ros2_control Hardware Interface ========== -->
  <!-- Sahadev uses offset ports: 50005-50008 to avoid conflicts with Nakul -->
  <xacro:ur_ros2_control_patched
    name="sahadev_ur5e"
    tf_prefix="sahadev_"
    robot_ip="$(arg sahadev_robot_ip)"
    use_fake_hardware="$(arg sahadev_use_fake_hardware)"
    fake_sensor_commands="$(arg sahadev_fake_sensor_commands)"
    hash_kinematics="$(arg sahadev_hash_kinematics)"
    headless_mode="$(arg headless_mode)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    reverse_port="50005"
    script_sender_port="50006"
    trajectory_port="50007"
    script_command_port="50008"
    keep_alive_count="50"
    servoj_gain="750"
    servoj_lookahead_time="0.2"
  />

</robot>
