<?xml version="1.0"?>
<!--
Face Robot UR20 Cell Macro

Single UR20 robot at world origin with iPhone tool.
8 face targets arranged in a circle at 1.2m radius, z=1.0m.
No optical table — robot is floor-mounted.

The face targets are spaced 45° apart:
  face_0:   0°   → ( 1.200,  0.000, 1.0)
  face_1:  45°   → ( 0.849,  0.849, 1.0)
  face_2:  90°   → ( 0.000,  1.200, 1.0)
  face_3: 135°   → (-0.849,  0.849, 1.0)
  face_4: 180°   → (-1.200,  0.000, 1.0)
  face_5: 225°   → (-0.849, -0.849, 1.0)
  face_6: 270°   → ( 0.000, -1.200, 1.0)
  face_7: 315°   → ( 0.849, -0.849, 1.0)

Each face is oriented to look towards the robot (yaw = angle + 90°).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="face_robot_ur20_cell" params="parent
    ur_type joint_limits_parameters_file kinematics_parameters_file
    physical_parameters_file visual_parameters_file
    *origin">

    <!-- ================================================================ -->
    <!-- Shop Floor - Ground plane at z=0                                 -->
    <!-- ================================================================ -->
    <link name="shop_floor">
      <visual>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <box size="5.0 5.0 0.1"/>
        </geometry>
        <material name="floor_gray">
          <color rgba="0.4 0.4 0.4 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <box size="5.0 5.0 0.1"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_shop_floor" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="shop_floor"/>
    </joint>

    <!-- ================================================================ -->
    <!-- UR20 Robot — single robot at world origin                        -->
    <!-- No tf_prefix — joint names are shoulder_pan_joint, etc.          -->
    <!-- ================================================================ -->
    <xacro:ur_robot
      name="ur20"
      tf_prefix=""
      parent="shop_floor"
      joint_limits_parameters_file="${joint_limits_parameters_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      physical_parameters_file="${physical_parameters_file}"
      visual_parameters_file="${visual_parameters_file}"
    >
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot>

    <!-- ================================================================ -->
    <!-- iPhone Tool                                                      -->
    <!-- Attached to wrist_3_link with offset [-0.08, 0, 0.03]           -->
    <!-- ================================================================ -->
    <link name="tool_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/iphone.stl" scale="0.04 0.04 0.04"/>
        </geometry>
        <material name="iphone_gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.065 0 0.02" rpy="1.5708 0 0"/>
        <geometry>
          <box size="0.3 0.16 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <link name="tool_tip_link"/>

    <joint name="wrist_3_to_tool" type="fixed">
      <origin xyz="-0.08 0 0.03" rpy="1.57 0 0"/>
      <parent link="wrist_3_link"/>
      <child link="tool_base_link"/>
    </joint>

    <joint name="tool_base_to_tip" type="fixed">
      <parent link="tool_base_link"/>
      <child link="tool_tip_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ================================================================ -->
    <!-- Face Targets — 8 faces in a circle at 1.2m radius, z=1.0m       -->
    <!--                                                                  -->
    <!-- Each face_link_N is a separate TF frame. The face mesh is        -->
    <!-- oriented with yaw so it looks toward the robot at origin.        -->
    <!-- ================================================================ -->

    <!-- face_0: 0° → (1.2, 0, 1.0), yaw=90° (faces inward) -->
    <link name="face_link_0">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_0" type="fixed">
      <origin xyz="1.2 0 1.0" rpy="0 0 1.5708"/>
      <parent link="shop_floor"/>
      <child link="face_link_0"/>
    </joint>

    <!-- face_1: 45° → (0.849, 0.849, 1.0), yaw=135° -->
    <link name="face_link_1">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_1"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_1" type="fixed">
      <origin xyz="0.849 0.849 1.0" rpy="0 0 2.3562"/>
      <parent link="shop_floor"/>
      <child link="face_link_1"/>
    </joint>

    <!-- face_2: 90° → (0, 1.2, 1.0), yaw=180° -->
    <link name="face_link_2">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_2"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_2" type="fixed">
      <origin xyz="0 1.2 1.0" rpy="0 0 3.1416"/>
      <parent link="shop_floor"/>
      <child link="face_link_2"/>
    </joint>

    <!-- face_3: 135° → (-0.849, 0.849, 1.0), yaw=225° -->
    <link name="face_link_3">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_3"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_3" type="fixed">
      <origin xyz="-0.849 0.849 1.0" rpy="0 0 3.9270"/>
      <parent link="shop_floor"/>
      <child link="face_link_3"/>
    </joint>

    <!-- face_4: 180° → (-1.2, 0, 1.0), yaw=270° -->
    <link name="face_link_4">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_4"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_4" type="fixed">
      <origin xyz="-1.2 0 1.0" rpy="0 0 4.7124"/>
      <parent link="shop_floor"/>
      <child link="face_link_4"/>
    </joint>

    <!-- face_5: 225° → (-0.849, -0.849, 1.0), yaw=315° -->
    <link name="face_link_5">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_5"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_5" type="fixed">
      <origin xyz="-0.849 -0.849 1.0" rpy="0 0 5.4978"/>
      <parent link="shop_floor"/>
      <child link="face_link_5"/>
    </joint>

    <!-- face_6: 270° → (0, -1.2, 1.0), yaw=0° (faces along +X) -->
    <link name="face_link_6">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_6"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_6" type="fixed">
      <origin xyz="0 -1.2 1.0" rpy="0 0 0.0"/>
      <parent link="shop_floor"/>
      <child link="face_link_6"/>
    </joint>

    <!-- face_7: 315° → (0.849, -0.849, 1.0), yaw=45° -->
    <link name="face_link_7">
      <visual>
        <origin xyz="0 -0.09 0" rpy="1.5708 0 -3.14"/>
        <geometry>
          <mesh filename="package://face_robot_ur20_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin_7"><color rgba="0.92 0.76 0.65 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry><sphere radius="0.1"/></geometry>
      </collision>
    </link>
    <joint name="floor_to_face_7" type="fixed">
      <origin xyz="0.849 -0.849 1.0" rpy="0 0 0.7854"/>
      <parent link="shop_floor"/>
      <child link="face_link_7"/>
    </joint>

  </xacro:macro>

</robot>
