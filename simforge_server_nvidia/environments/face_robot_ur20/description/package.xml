<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>face_robot_ur20_description</name>
  <version>1.0.0</version>
  <description>
    Face Robot UR20 cell description — single UR20 with iPhone tool
