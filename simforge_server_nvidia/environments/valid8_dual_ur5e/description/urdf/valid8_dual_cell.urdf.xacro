<?xml version="1.0"?>
<!--
Valid8 Dual Robot Cell URDF

This XACRO file defines the complete Valid8 workcell with TWO UR5e robots:
- nakul_ur5e: Position [-0.6758, 0, 1.03] with -90° yaw, IP 192.168.1.9
- sahadev_ur5e: Position [0.6758, 0, 1.03] with +90° yaw, IP 192.168.1.16

Based on Universal Robots ROS2 Dual Robot Tutorial:
https://github.com/UniversalRobots/Universal_Robots_ROS2_Tutorials/tree/main/my_dual_robot_cell
-->
<robot name="valid8_dual_cell" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Include UR robot macro from ur_description -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  
  <!-- Include Valid8 dual cell macro -->
  <xacro:include filename="$(find valid8_dual_cell_description)/urdf/valid8_dual_cell_macro.xacro"/>

  <!-- ========== Arguments for Nakul (first robot) ========== -->
  <xacro:arg name="nakul_ur_type" default="ur5e"/>
  <xacro:arg name="nakul_joint_limits_parameters_file" default="$(find ur_description)/config/$(arg nakul_ur_type)/joint_limits.yaml"/>
  <xacro:arg name="nakul_kinematics_parameters_file" default="$(find ur_description)/config/$(arg nakul_ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="nakul_physical_parameters_file" default="$(find ur_description)/config/$(arg nakul_ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="nakul_visual_parameters_file" default="$(find ur_description)/config/$(arg nakul_ur_type)/visual_parameters.yaml"/>

  <!-- ========== Arguments for Sahadev (second robot) ========== -->
  <xacro:arg name="sahadev_ur_type" default="ur5e"/>
  <xacro:arg name="sahadev_joint_limits_parameters_file" default="$(find ur_description)/config/$(arg sahadev_ur_type)/joint_limits.yaml"/>
  <xacro:arg name="sahadev_kinematics_parameters_file" default="$(find ur_description)/config/$(arg sahadev_ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="sahadev_physical_parameters_file" default="$(find ur_description)/config/$(arg sahadev_ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="sahadev_visual_parameters_file" default="$(find ur_description)/config/$(arg sahadev_ur_type)/visual_parameters.yaml"/>

  <!-- ========== World Link ========== -->
  <link name="world"/>

  <!-- ========== Valid8 Dual Robot Workcell ========== -->
  <xacro:valid8_dual_cell parent="world"
    nakul_ur_type="$(arg nakul_ur_type)"
    nakul_joint_limits_parameters_file="$(arg nakul_joint_limits_parameters_file)"
    nakul_kinematics_parameters_file="$(arg nakul_kinematics_parameters_file)"
    nakul_physical_parameters_file="$(arg nakul_physical_parameters_file)"
    nakul_visual_parameters_file="$(arg nakul_visual_parameters_file)"
    sahadev_ur_type="$(arg sahadev_ur_type)"
    sahadev_joint_limits_parameters_file="$(arg sahadev_joint_limits_parameters_file)"
    sahadev_kinematics_parameters_file="$(arg sahadev_kinematics_parameters_file)"
    sahadev_physical_parameters_file="$(arg sahadev_physical_parameters_file)"
    sahadev_visual_parameters_file="$(arg sahadev_visual_parameters_file)"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:valid8_dual_cell>

</robot>
