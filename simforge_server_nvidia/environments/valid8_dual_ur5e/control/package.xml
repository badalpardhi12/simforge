<?xml version="1.0"?>
<package format="3">
  <name>valid8_dual_cell_control</name>
  <version>2.0.0</version>
  <description>
    Valid8 Dual Robot Cell Control Package
    
    Contains ros2_control configuration for two UR5e robots:
    - nakul_ur5e: IP 192.168.1.9
    - sahadev_ur5e: IP 192.168.1.16
    
    Based on Universal Robots ROS2 Tutorials:
    https://github.com/UniversalRobots/Universal_Robots_ROS2_Tutorials/tree/main/my_dual_robot_cell
  </description>
  <maintainer email="team@valid8.ai">Valid8 Team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Description packages -->
  <depend>valid8_dual_cell_description</depend>
  <depend>ur_description</depend>
  
  <!-- UR Robot Driver -->
  <depend>ur_robot_driver</depend>
  
  <!-- ros2_control -->
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>force_torque_sensor_broadcaster</depend>
  <depend>speed_scaling_state_broadcaster</depend>
  
  <!-- Launch dependencies -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>
  
  <!-- Foxglove -->
  <depend>foxglove_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
