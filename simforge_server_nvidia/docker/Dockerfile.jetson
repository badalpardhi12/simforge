# ──────────────────────────────────────────────────────────────
# SimForge Server — NVIDIA cuRobo Backend (Jetson Thor / JetPack 7)
#
# GPU-accelerated motion planning with NVIDIA cuRobo.
# Real-robot control via ur_rtde (built from source for aarch64).
# Simulated control via ros2_control (mock hardware).
#
# Build context: simforge_server_nvidia/
#
# Base: nvidia/cuda:13.0.1-devel-ubuntu24.04
#   - Ubuntu 24.04 (Noble) aarch64
#   - CUDA 13.0.1 (supports compute_110 / sm_110 for Thor iGPU)
#   - Python 3.12
#
# PyTorch: 2.10.0+cu130 from official PyTorch cu130 index
#   - Pre-built aarch64 wheel with sm_110 support
#
# ROS2: Jazzy Jalisco (native Ubuntu 24.04 support)
#
# Target: NVIDIA Jetson AGX Thor (compute capability 11.0)
# Must be built natively on the Jetson device (no cross-compilation)
#
# Note: The nvcr.io/nvidia/pytorch:26.01-py3-igpu image ships CUDA 12.9
#       and PyTorch compiled only for sm_87 (Orin). Thor's iGPU is sm_110
#       which requires CUDA 13.0+ and a matching PyTorch build.
#       See: https://forums.developer.nvidia.com/t/348679/3
# ──────────────────────────────────────────────────────────────

FROM nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04

LABEL maintainer="valid8.ai"
LABEL description="SimForge Server – NVIDIA cuRobo GPU Motion Planning (Jetson Thor)"
LABEL version="2.0.0-jetson"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# ── Locale ───────────────────────────────────────────────────
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# ── Essential tools ──────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl gnupg lsb-release wget git \
    cmake build-essential \
    python3-pip python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*

# ── Install ROS2 Jazzy (native for Ubuntu 24.04 Noble) ──────
# Add ROS 2 apt source
RUN apt-get update && apt-get install -y curl && \
    export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') && \
    curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.noble_all.deb" && \
    dpkg -i /tmp/ros2-apt-source.deb && \
    rm /tmp/ros2-apt-source.deb && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-base \
    ros-jazzy-rclpy \
    ros-jazzy-std-msgs \
    ros-jazzy-std-srvs \
    ros-jazzy-geometry-msgs \
    ros-jazzy-sensor-msgs \
    ros-jazzy-trajectory-msgs \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-control-msgs \
    ros-jazzy-visualization-msgs \
    ros-jazzy-nav-msgs \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-xacro \
    ros-jazzy-urdf \
    python3-colcon-common-extensions \
    python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ── UR Robot Driver + ros2_control ───────────────────────────
# Required for:
#   - ros2_control_node (fake hardware in sim, UR driver in real)
#   - joint_state_broadcaster (/joint_states in sim mode)
#   - scaled_joint_trajectory_controller (FollowJointTrajectory in sim)
#   - controller_stopper_node (headless mode URScript re-send)
#   - ur_description URDF macros
RUN apt-get update && apt-get install -y \
    ros-jazzy-ur-robot-driver \
    ros-jazzy-ur-description \
    ros-jazzy-ur-calibration \
    ros-jazzy-controller-manager \
    ros-jazzy-joint-state-broadcaster \
    ros-jazzy-joint-trajectory-controller \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-force-torque-sensor-broadcaster \
    && rm -rf /var/lib/apt/lists/*

# ── Foxglove Bridge ─────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    ros-jazzy-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# ── Additional ROS2 deps ────────────────────────────────────
RUN apt-get update && apt-get install -y \
    ros-jazzy-kdl-parser \
    ros-jazzy-ament-cmake-python \
    && rm -rf /var/lib/apt/lists/*

# Initialise rosdep
RUN rosdep init || true && rosdep update

# ── NVIDIA cuRobo (from source) ─────────────────────────────
# Jetson Thor: compute capability 11.0 (Blackwell-derived iGPU)
# CUDA 13.0.1 toolkit supports compute_110 natively.

# Install PyTorch with sm_110 support from the official cu130 index
RUN pip3 install --no-cache-dir --break-system-packages \
    torch==2.10.0+cu130 \
    --index-url https://download.pytorch.org/whl/cu130

# ── Replace SBSA cuBLAS with Jetson-specific cuBLAS ─────────
# The nvidia/cuda:13.0.1-devel image ships SBSA (server ARM) cuBLAS
# which does NOT support Jetson Thor's iGPU (sm_110).
# Install the Jetson-specific cuBLAS from NVIDIA's Jetson apt repo.
# Pin to Jetson repo version to avoid conflicts with the SBSA repo.
RUN curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
        -o /etc/apt/trusted.gpg.d/jetson-ota-public.asc && \
    echo "deb https://repo.download.nvidia.com/jetson/common r38.4 main" \
        > /etc/apt/sources.list.d/nvidia-jetson.list && \
    apt-get update && \
    apt-get download libcublas-13-0 && \
    dpkg --force-overwrite -i libcublas-13-0*.deb && \
    rm -f libcublas-13-0*.deb && \
    ldconfig && \
    rm -rf /var/lib/apt/lists/*

# Ensure Jetson CUDA libraries take precedence over SBSA ones
ENV LD_LIBRARY_PATH="/usr/local/cuda-13.0/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

RUN apt-get update && apt-get install -y git-lfs ninja-build && rm -rf /var/lib/apt/lists/*
ENV TORCH_CUDA_ARCH_LIST="11.0+PTX"
RUN git lfs install && \
    git clone https://github.com/NVlabs/curobo.git /tmp/curobo && \
    cd /tmp/curobo && \
    pip3 install --no-cache-dir --break-system-packages -e . --no-build-isolation && \
    rm -rf /tmp/curobo/.git

# ── Build ur_rtde from source (no aarch64 pip package) ──────
RUN apt-get update && apt-get install -y \
    libboost-system-dev libboost-thread-dev libboost-program-options-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN git clone https://gitlab.com/sdurobotics/ur_rtde.git && \
    cd ur_rtde && \
    git checkout v1.5.8 && \
    git submodule update --init --recursive && \
    mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DPYTHON_BINDINGS=ON \
          -DPYTHON_EXECUTABLE=$(which python3) \
          .. && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf ur_rtde

# ── Python dependencies for gateway ─────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages \
    websockets>=12.0 \
    numpy>=1.24.0 \
    scipy>=1.10.0 \
    transforms3d>=0.4.1 \
    pyyaml>=6.0

# ── Create workspace ────────────────────────────────────────
WORKDIR /ros2_ws

# ── Source layers (ordered least→most frequently changed) ────

# Layer 1 — Environment-specific ROS2 packages (rarely change)
COPY environments/valid8_dual_ur5e/description /ros2_ws/src/valid8_dual_cell_description
COPY environments/valid8_dual_ur5e/control     /ros2_ws/src/valid8_dual_cell_control
COPY environments/face_robot_ur20/description  /ros2_ws/src/face_robot_ur20_description
COPY environments/face_robot_ur20/control      /ros2_ws/src/face_robot_ur20_control

# Layer 2 — Gateway package manifest (changes when deps change)
COPY CMakeLists.txt  /ros2_ws/src/simforge_gateway_nvidia/CMakeLists.txt
COPY package.xml     /ros2_ws/src/simforge_gateway_nvidia/package.xml

# Layer 3 — Config + launch (change occasionally)
COPY config /ros2_ws/src/simforge_gateway_nvidia/config
COPY launch /ros2_ws/src/simforge_gateway_nvidia/launch

# Layer 4 — Python package + nodes + tests (change most often)
COPY simforge_gateway_nvidia /ros2_ws/src/simforge_gateway_nvidia/simforge_gateway_nvidia
COPY nodes  /ros2_ws/src/simforge_gateway_nvidia/nodes
COPY tests  /ros2_ws/src/simforge_gateway_nvidia/tests

# ── Build ROS2 packages ─────────────────────────────────────
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && \
    cd /ros2_ws && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release"

# ── Entrypoint & start script ───────────────────────────────
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

COPY scripts/start_server.sh /start_server.sh
RUN chmod +x /start_server.sh

# ── Environment ──────────────────────────────────────────────
ENV ROS_DOMAIN_ID=42
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_HOME="/usr/local/cuda"
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# 9090 — Foxglove Bridge WebSocket
# 8766 — cuRobo Command Gateway WebSocket
EXPOSE 9090
EXPOSE 8766

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
