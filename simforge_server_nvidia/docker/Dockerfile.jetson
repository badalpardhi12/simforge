# ──────────────────────────────────────────────────────────────
# SimForge Server — NVIDIA cuRobo Backend (Jetson Thor / JetPack 7)
#
# GPU-accelerated motion planning with NVIDIA cuRobo.
# Real-robot control via ur_rtde (direct RTDE protocol).
# Simulated control via ros2_control (mock hardware).
#
# Build context: simforge_server_nvidia/
#
# Target: NVIDIA Jetson Thor (Blackwell, sm_120)
#         JetPack 7.0: Ubuntu 24.04, CUDA 13.x, Python 3.12
#         ROS2 Jazzy Jalisco (Ubuntu 24.04 Noble target)
#
# IMPORTANT: This Dockerfile MUST be built on the Jetson Thor
# device itself (native build), not cross-compiled, because:
#   1. cuRobo CUDA kernels compile against the local GPU
#   2. PyTorch arm64 wheels are architecture-specific
#   3. NVIDIA Container Runtime must be the default runtime
#      during build (for CUDA access during pip install)
#
# Prerequisites on the Jetson Thor host:
#   - JetPack 7.0 installed via SDK Manager
#   - Docker + NVIDIA Container Toolkit installed
#   - /etc/docker/daemon.json has "default-runtime": "nvidia"
# ──────────────────────────────────────────────────────────────

# ── Base: Ubuntu 24.04 with CUDA 13 (JetPack 7 compatible) ──
# On JetPack 7, CUDA is provided by the host via nvidia-container-runtime.
# We use the official L4T base which includes the CUDA toolkit.
FROM nvcr.io/nvidia/l4t-cuda:13.0-devel

LABEL maintainer="valid8.ai"
LABEL description="SimForge Server – NVIDIA cuRobo GPU Motion Planning (Jetson Thor)"
LABEL version="2.0.0-jetson"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# ── Locale ───────────────────────────────────────────────────
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# ── Essential tools ──────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl gnupg lsb-release wget git \
    cmake build-essential \
    python3-pip python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*

# ── Install ROS2 Jazzy (Ubuntu 24.04 Noble) ─────────────────
# Jazzy Jalisco is the ROS2 LTS for Ubuntu 24.04.
# ROS2 Humble only targets Ubuntu 22.04 (Jammy) and does not
# have arm64 debs for Noble.
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu noble main" \
    > /etc/apt/sources.list.d/ros2.list

RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-base \
    ros-jazzy-rclpy \
    ros-jazzy-std-msgs \
    ros-jazzy-std-srvs \
    ros-jazzy-geometry-msgs \
    ros-jazzy-sensor-msgs \
    ros-jazzy-trajectory-msgs \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-control-msgs \
    ros-jazzy-visualization-msgs \
    ros-jazzy-nav-msgs \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-xacro \
    ros-jazzy-urdf \
    python3-colcon-common-extensions \
    python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ── UR Robot Driver + ros2_control ───────────────────────────
RUN apt-get update && apt-get install -y \
    ros-jazzy-ur-robot-driver \
    ros-jazzy-ur-description \
    ros-jazzy-controller-manager \
    ros-jazzy-joint-state-broadcaster \
    ros-jazzy-joint-trajectory-controller \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-force-torque-sensor-broadcaster \
    && rm -rf /var/lib/apt/lists/*

# ── Foxglove Bridge ─────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    ros-jazzy-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# ── Additional ROS2 deps ────────────────────────────────────
RUN apt-get update && apt-get install -y \
    ros-jazzy-kdl-parser \
    ros-jazzy-ament-cmake-python \
    && rm -rf /var/lib/apt/lists/*

# Initialise rosdep
RUN rosdep init || true && rosdep update

# ── PyTorch (Jetson-specific) ────────────────────────────────
# On Jetson Thor (JetPack 7), PyTorch must be installed from
# NVIDIA's Jetson-specific wheels, not PyPI.
#
# Option A: If building on the device with JetPack 7 PyTorch
#           wheel already available via jetson-ai-lab:
# pip3 install --no-cache-dir <jetson-pytorch-wheel-url>
#
# Option B: Use the pre-installed PyTorch from L4T base image.
#
# We install from NVIDIA's Jetson AI Lab PyPI mirror which
# automatically provides the correct arm64 + CUDA wheel.
# Fallback: build from source if no wheel available.
RUN pip3 install --no-cache-dir --break-system-packages \
    --extra-index-url https://pypi.jetson-ai-lab.io/jp7/cu130 \
    torch || \
    echo "WARNING: Pre-built PyTorch wheel not found for JetPack 7. \
    Install manually: pip3 install torch from NVIDIA's Jetson containers."

# ── NVIDIA cuRobo (from source) ─────────────────────────────
# Jetson Thor uses Blackwell GPU with sm_120 compute capability.
# CUDA 13 is required; older cuRobo may need the arch list patched.
RUN apt-get update && apt-get install -y git-lfs ninja-build && rm -rf /var/lib/apt/lists/*

# Include both current x86 targets and Jetson Thor's sm_120.
# During build on Jetson, only the native arch will compile;
# PTX provides forward compatibility.
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0+PTX"

RUN git lfs install && \
    git clone https://github.com/NVlabs/curobo.git /tmp/curobo && \
    cd /tmp/curobo && \
    pip3 install --break-system-packages -e . --no-build-isolation && \
    rm -rf /tmp/curobo/.git

# ── Python dependencies for gateway ─────────────────────────
# ur-rtde has no pre-built arm64 wheel — it builds from source
# via CMake and needs libboost headers.
RUN apt-get update && apt-get install -y \
    libboost-system-dev libboost-thread-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
    websockets>=12.0 \
    numpy>=1.24.0 \
    scipy>=1.10.0 \
    transforms3d>=0.4.1 \
    pyyaml>=6.0 \
    ur-rtde>=1.5.0

# ── Create workspace ────────────────────────────────────────
WORKDIR /ros2_ws

# ── Source layers (ordered least→most frequently changed) ────

# Layer 1 — Environment-specific ROS2 packages (rarely change)
COPY environments/valid8_dual_ur5e/description /ros2_ws/src/valid8_dual_cell_description
COPY environments/valid8_dual_ur5e/control     /ros2_ws/src/valid8_dual_cell_control
COPY environments/face_robot_ur20/description  /ros2_ws/src/face_robot_ur20_description
COPY environments/face_robot_ur20/control      /ros2_ws/src/face_robot_ur20_control

# Layer 2 — Gateway package manifest (changes when deps change)
COPY CMakeLists.txt  /ros2_ws/src/simforge_gateway_nvidia/CMakeLists.txt
COPY package.xml     /ros2_ws/src/simforge_gateway_nvidia/package.xml

# Layer 3 — Config + launch (change occasionally)
COPY config /ros2_ws/src/simforge_gateway_nvidia/config
COPY launch /ros2_ws/src/simforge_gateway_nvidia/launch

# Layer 4 — Python package + nodes + tests (change most often)
COPY simforge_gateway_nvidia /ros2_ws/src/simforge_gateway_nvidia/simforge_gateway_nvidia
COPY nodes  /ros2_ws/src/simforge_gateway_nvidia/nodes
COPY tests  /ros2_ws/src/simforge_gateway_nvidia/tests

# ── Build ROS2 packages ─────────────────────────────────────
# Source Jazzy instead of Humble
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && \
    cd /ros2_ws && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release"

# ── Entrypoint & start script ───────────────────────────────
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

COPY scripts/start_server.sh /start_server.sh
RUN chmod +x /start_server.sh

# ── Environment ──────────────────────────────────────────────
ENV ROS_DOMAIN_ID=42
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# 9090 — Foxglove Bridge WebSocket
# 8766 — cuRobo Command Gateway WebSocket
EXPOSE 9090
EXPOSE 8766

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
