<?xml version="1.0" ?>
<robot name="iphone_tool">
  <link name="tool_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14"/>
      <geometry>
  <mesh filename="../tools/iphone.stl" scale="0.04 0.04 0.04"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.065 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.13 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <link name="tool_tip_link" />
  <joint name="tool_base_to_tip" type="fixed">
    <parent link="tool_base_link"/>
    <child link="tool_tip_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
