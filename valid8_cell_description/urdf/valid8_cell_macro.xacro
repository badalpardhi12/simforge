<?xml version="1.0"?>
<!--
Valid8 Robot Cell Macro

This macro defines the Valid8 workcell environment including:
- Shop floor
- Optical table
- Face fixture
- Robot mount (parent link for UR robot)

The robot is instantiated separately using ur_robot macro with tf_prefix support.

Based on positions from valid8_setup.yaml:
- optical_table: [0, 0, 1.0]
- face_link: [0.1742, 0, 1.6] with 90° yaw
- robot base: [-0.6758, 0, 1.03] with -90° yaw relative to world

Usage:
  <xacro:include filename="$(find valid8_cell_description)/urdf/valid8_cell_macro.xacro"/>
  <xacro:valid8_cell parent="world"/>
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="valid8_cell" params="parent *origin">
    
    <!-- Shop Floor - Ground plane at z=0 -->
    <link name="shop_floor">
      <visual>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <box size="5.0 5.0 0.1"/>
        </geometry>
        <material name="floor_gray">
          <color rgba="0.4 0.4 0.4 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <box size="5.0 5.0 0.1"/>
        </geometry>
      </collision>
    </link>
    
    <joint name="${parent}_to_shop_floor" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="shop_floor"/>
    </joint>
    
    <!-- Optical Table - Main workspace surface -->
    <!-- Table top at z=1.0m from world -->
    <link name="table_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://valid8_cell_description/meshes/optical_table.dae" scale="1.4 1.37 1.17"/>
        </geometry>
        <material name="table_black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <!-- Collision box for the table -->
        <origin xyz="0 0 -0.5" rpy="0 0 0"/>
        <geometry>
          <box size="2.1 1.1 1.04"/>
        </geometry>
      </collision>
    </link>
    
    <joint name="floor_to_table" type="fixed">
      <!-- Table surface at z=1.0m -->
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <parent link="shop_floor"/>
      <child link="table_link"/>
    </joint>
    
    <!-- Face Fixture - Test subject mount -->
    <!-- Position: [0.1742, 0, 1.6] with 90° yaw from valid8_setup.yaml -->
    <link name="face_link">
      <visual>
        <!-- Visual origin from non_pii_face_valid8.urdf -->
        <origin xyz="0 -0.09 0" rpy="0 0 -3.14"/>
        <geometry>
          <mesh filename="package://valid8_cell_description/meshes/generix_human_head.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="face_skin">
          <color rgba="0.92 0.76 0.65 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
        <geometry>
          <sphere radius="0.1"/>
        </geometry>
      </collision>
    </link>
    
    <joint name="floor_to_face" type="fixed">
      <!-- Face at [0.1742, 0, 1.6] with 90° yaw (1.5708 rad) -->
      <origin xyz="0.1742 0 1.6" rpy="0 0 1.5708"/>
      <parent link="shop_floor"/>
      <child link="face_link"/>
    </joint>
    
    <!-- Robot Mount - The parent link for the UR robot -->
    <!-- This is where the robot base will be attached -->
    <!-- Position: [-0.6758, 0, 1.03] with -90° yaw from valid8_setup.yaml -->
    <link name="robot_mount"/>
    
    <joint name="floor_to_robot_mount" type="fixed">
      <!-- Robot mount at [-0.6758, 0, 1.03] with -90° yaw (-1.5708 rad) -->
      <origin xyz="-0.6758 0 1.03" rpy="0 0 -1.5708"/>
      <parent link="shop_floor"/>
      <child link="robot_mount"/>
    </joint>
    
  </xacro:macro>

</robot>
