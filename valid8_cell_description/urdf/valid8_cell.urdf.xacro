<?xml version="1.0"?>
<!--
Valid8 Robot Cell Description

This XACRO file defines the complete Valid8 workcell including:
- Shop floor, optical table, face fixture (from valid8_cell_macro.xacro)
- UR series robot (from ur_description/ur_macro.xacro)

The robot is instantiated with tf_prefix support for multi-robot scenarios.
The robot is attached to the robot_mount link with proper transform.

Usage:
  # Default (UR5e)
  xacro valid8_cell.urdf.xacro ur_type:=ur5e
  
  # Different robot types
  xacro valid8_cell.urdf.xacro ur_type:=ur20
  
  # With custom kinematics calibration
  xacro valid8_cell.urdf.xacro ur_type:=ur5e kinematics_parameters_file:=/path/to/calibration.yaml

Parameters:
  - ur_type: Type of UR robot (ur3, ur3e, ur5, ur5e, ur10, ur10e, ur16e, ur20, ur30)
  - tf_prefix: Prefix for all robot TF frames (e.g., "ur5e_" or "robot1_")
  - kinematics_parameters_file: Path to robot calibration YAML
  - joint_limits_parameters_file: Path to joint limits YAML
  - visual_parameters_file: Path to visual parameters YAML

Based on Universal Robots ROS 2 custom workcell tutorial:
https://docs.universal-robots.com/Universal_Robots_ROS_Documentation/doc/ur_tutorials/my_robot_cell/doc/assemble_urdf.html
-->
<robot name="valid8_cell" xmlns:xacro="http://wiki.ros.org/xacro">
  
  <!-- Include UR robot macro from ur_description -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  
  <!-- Include Valid8 cell macro -->
  <xacro:include filename="$(find valid8_cell_description)/urdf/valid8_cell_macro.xacro"/>
  
  <!-- ========== Arguments ========== -->
  
  <!-- Robot type (must match ur_description types) -->
  <xacro:arg name="ur_type" default="ur5e"/>
  
  <!-- TF prefix for multi-robot support -->
  <!-- Use format: "robot1_" or "ur5e_" to prefix all robot frames -->
  <xacro:arg name="tf_prefix" default=""/>
  
  <!-- Kinematics calibration file (extract from real robot for accuracy) -->
  <xacro:arg name="kinematics_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  
  <!-- Joint limits (can be customized per deployment) -->
  <xacro:arg name="joint_limits_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  
  <!-- Physical parameters file (required by ur_macro) -->
  <xacro:arg name="physical_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  
  <!-- Visual parameters -->
  <xacro:arg name="visual_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  
  <!-- ========== ros2_control Parameters (required by UR driver) ========== -->
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>
  <xacro:arg name="script_filename" default=""/>
  <xacro:arg name="output_recipe_filename" default=""/>
  <xacro:arg name="input_recipe_filename" default=""/>
  <xacro:arg name="reverse_ip" default="0.0.0.0"/>
  <xacro:arg name="script_command_port" default="50004"/>
  <xacro:arg name="reverse_port" default="50001"/>
  <xacro:arg name="script_sender_port" default="50002"/>
  <xacro:arg name="trajectory_port" default="50003"/>
  <xacro:arg name="use_tool_communication" default="false"/>
  <xacro:arg name="tool_voltage" default="0"/>
  <xacro:arg name="tool_parity" default="0"/>
  <xacro:arg name="tool_baud_rate" default="115200"/>
  <xacro:arg name="tool_stop_bits" default="1"/>
  <xacro:arg name="tool_rx_idle_chars" default="1.5"/>
  <xacro:arg name="tool_tx_idle_chars" default="3.5"/>
  <xacro:arg name="tool_device_name" default="/tmp/ttyUR"/>
  <xacro:arg name="tool_tcp_port" default="54321"/>
  <!-- Increase keep_alive_count significantly to give more time for commands -->
  <!-- At 500Hz, count of 500 = 1000 seconds (~16 minutes) -->
  <xacro:arg name="keep_alive_count" default="500"/>
  
  <!-- Initial positions for simulation -->
  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>
  
  <!-- ========== World Link ========== -->
  <link name="world"/>
  
  <!-- ========== Valid8 Workcell ========== -->
  <!-- Creates: shop_floor, table_link, face_link, robot_mount -->
  <xacro:valid8_cell parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:valid8_cell>
  
  <!-- ========== UR Robot ========== -->
  <!-- The robot is attached to robot_mount link -->
  <!-- robot_mount is at [-0.6758, 0, 1.03] with -90° yaw in world frame -->
  <!-- Robot origin relative to mount is [0, 0, 0] - the mount IS the robot base position -->
  <xacro:ur_robot
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    parent="robot_mount"
    joint_limits_parameters_file="$(arg joint_limits_parameters_file)"
    kinematics_parameters_file="$(arg kinematics_parameters_file)"
    physical_parameters_file="$(arg physical_parameters_file)"
    visual_parameters_file="$(arg visual_parameters_file)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"
    headless_mode="$(arg headless_mode)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
    robot_ip="$(arg robot_ip)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    reverse_ip="$(arg reverse_ip)"
    script_command_port="$(arg script_command_port)"
    reverse_port="$(arg reverse_port)"
    script_sender_port="$(arg script_sender_port)"
    trajectory_port="$(arg trajectory_port)"
    use_tool_communication="$(arg use_tool_communication)"
    tool_voltage="$(arg tool_voltage)"
    tool_parity="$(arg tool_parity)"
    tool_baud_rate="$(arg tool_baud_rate)"
    tool_stop_bits="$(arg tool_stop_bits)"
    tool_rx_idle_chars="$(arg tool_rx_idle_chars)"
    tool_tx_idle_chars="$(arg tool_tx_idle_chars)"
    tool_device_name="$(arg tool_device_name)"
    tool_tcp_port="$(arg tool_tcp_port)"
    keep_alive_count="$(arg keep_alive_count)"
  >
    <!-- Robot base is directly on the mount (no additional offset) -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>
  
  <!-- ========== iPhone Tool ========== -->
  <!-- Attached to wrist_3_link (end of robot) -->
  <!-- Based on valid8_setup.yaml: attach_pose: [-0.08, 0, 0, 0, 0, 0] -->
  <xacro:property name="tf_prefix_val" value="$(arg tf_prefix)"/>
  
  <link name="${tf_prefix_val}tool_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14"/>
      <geometry>
        <mesh filename="package://valid8_cell_description/meshes/iphone.stl" scale="0.04 0.04 0.04"/>
      </geometry>
      <material name="iphone_gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.065 0 0.02" rpy="1.57 0 0"/>
      <geometry>
        <box size="0.3 0.13 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  
  <link name="${tf_prefix_val}tool_tip_link"/>
  
  <joint name="${tf_prefix_val}wrist_3_to_tool" type="fixed">
    <!-- Tool attached to wrist_3_link with offset from valid8_setup.yaml -->
    <origin xyz="-0.08 0 0.05" rpy="1.57 0 0"/>
    <parent link="${tf_prefix_val}wrist_3_link"/>
    <child link="${tf_prefix_val}tool_base_link"/>
  </joint>
  
  <joint name="${tf_prefix_val}tool_base_to_tip" type="fixed">
    <parent link="${tf_prefix_val}tool_base_link"/>
    <child link="${tf_prefix_val}tool_tip_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
</robot>
