<?xml version="1.0" encoding="UTF-8"?>
<robot name="valid8_environment">

  <!-- Planning Groups -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tool_tip_link" />
  </group>

  <group name="gripper">
    <link name="tool0" />
    <link name="tool_base_link" />
    <link name="tool_tip_link" />
  </group>

  <!-- End Effector -->
  <end_effector name="iphone_tool" parent_link="wrist_3_link" group="gripper" />

  <!-- Self-Collision Matrix (generated from URDF) -->
  <!-- Adjacent pairs -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="tool_base_link" link2="wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />
  <!-- Never pairs -->
  <disable_collisions link1="base" link2="base_link" reason="Never" />
  <disable_collisions link1="base" link2="base_link_inertia" reason="Never" />
  <disable_collisions link1="base" link2="flange" reason="Never" />
  <disable_collisions link1="base" link2="forearm_link" reason="Never" />
  <disable_collisions link1="base" link2="ft_frame" reason="Never" />
