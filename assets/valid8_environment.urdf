<?xml version="1.0" ?>
<!-- 
Combined URDF for Valid8 Environment
Based on env_presets/valid8_setup.yaml

Positions:
- shop_floor: [0, 0, 0]
- optical_table: [0, 0, 1.0]
- face_link: [0.1742, 0, 1.6] with 90° yaw
- robot base: [-0.6758, 0, 1.03] with -90° yaw
- iphone_tool: attached to wrist_3_link with offset [-0.08, 0, 0]
-->
<robot name="valid8_environment">
  
  <!-- ============== WORLD FRAME ============== -->
  <link name="world"/>
  
  <!-- ============== SHOP FLOOR ============== -->
  <!-- Floor plane at z=0 -->
  <link name="shop_floor">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="5.0 5.0 0.1"/>
      </geometry>
      <material name="floor_gray">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="5.0 5.0 0.1"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="world_to_floor" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="shop_floor"/>
  </joint>
  
  <!-- ============== OPTICAL TABLE ============== -->
  <!-- Table position: [0, 0, 1.0] -->
  <link name="table_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/tools/optical_table.dae" scale="1.4 1.37 1.17"/>
      </geometry>
      <material name="table_black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.5" rpy="0 0 0"/>
      <geometry>
        <box size="2.1 1.1 1.04"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="world_to_table" type="fixed">
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="table_link"/>
  </joint>
  
  <!-- ============== FACE FIXTURE ============== -->
  <!-- Face position: [0.1742, 0, 1.6] with 90° yaw (1.5708 rad) -->
  <!-- Visual origin matches non_pii_face_valid8.urdf: xyz="0 -0.09 0" rpy="0 0 -1.57" -->
  <link name="face_link">
    <visual>
      <origin xyz="0 -0.09 0" rpy="0 0 -3.14"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/non_pii_face/generix_human_head.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="face_skin">
        <color rgba="0.92 0.76 0.65 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.09 0" rpy="0 0 -1.5708"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_face" type="fixed">
    <!-- Face at [0.1742, 0, 1.6] with 90° yaw (from valid8_setup.yaml: pose_orientation_rpy: [0.0, 0.0, 90.0]) -->
    <origin xyz="0.1742 0 1.6" rpy="0 0 1.5708"/>
    <parent link="world"/>
    <child link="face_link"/>
  </joint>
  
  <!-- ============== UR5e ROBOT ============== -->
  <!-- Robot base at [-0.6758, 0, 1.03] with -90° yaw (-1.5708 rad) -->
  <link name="base_link"/>
  <link name="base_link_inertia">
    <visual>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072"/>
    </inertial>
  </link>
  <link name="shoulder_link">
    <visual>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/shoulder.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/shoulder.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.761"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.00193 -0.02561"/>
      <inertia ixx="0.0070021" ixy="7.3e-07" ixz="-1.053e-05" iyy="0.00648091" iyz="0.00049994" izz="0.00657286"/>
    </inertial>
  </link>
  <link name="upper_arm_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.138"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/upperarm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.138"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/upperarm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.058"/>
      <origin rpy="0 0 0" xyz="-0.2125 0.0 0.11336"/>
      <inertia ixx="0.01505885" ixy="-5.4e-05" ixz="5.63e-06" iyy="0.33388086" iyz="-1.81e-06" izz="0.33247207"/>
    </inertial>
  </link>
  <link name="forearm_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.007"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/forearm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.007"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/forearm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.846"/>
      <origin rpy="0 0 0" xyz="-0.2422 0.0 0.0265"/>
      <inertia ixx="0.00399632" ixy="-1.365e-05" ixz="0.00137272" iyy="0.07879254" iyz="-6.6e-06" izz="0.0784851"/>
    </inertial>
  </link>
  <link name="wrist_1_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.127"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/wrist1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.127"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/wrist1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.37"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01634 -0.0018"/>
      <inertia ixx="0.00165491" ixy="-2.82e-06" ixz="-4.38e-06" iyy="0.00135962" iyz="0.00010157" izz="0.00126279"/>
    </inertial>
  </link>
  <link name="wrist_2_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0997"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/wrist2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0997"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.3"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01634 -0.0018"/>
      <inertia ixx="0.00135617" ixy="-2.74e-06" ixz="4.44e-06" iyy="0.00127827" iyz="-5.048e-05" izz="0.00096614"/>
    </inertial>
  </link>
  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0989"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/visual/wrist3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0989"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/ur5e/meshes/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.365"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159"/>
      <inertia ixx="0.00018694" ixy="6e-08" ixz="-1.7e-07" iyy="0.00018908" iyz="-9.2e-07" izz="0.00025756"/>
    </inertial>
  </link>
  
  <!-- Robot base joint to world - positioned at [-0.6758, 0, 1.03] with -90° yaw -->
  <joint name="base_joint" type="fixed">
    <origin xyz="-0.6758 0 1.03" rpy="0 0 -1.5708"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  
  <!-- Robot internal joints -->
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  
  <!-- Robot end-effector frames -->
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  
  <!-- ============== iPHONE TOOL ============== -->
  <!-- iPhone tool attached to wrist_3_link -->
  <!-- Matches ur5e_with_iphone_tool.urdf: attach_pose=[-0.08, 0, 0, 0, 0, 0] from valid8_setup.yaml -->
  <link name="tool_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14"/>
      <geometry>
        <mesh filename="package://simforge_server/assets/tools/iphone.stl" scale="0.04 0.04 0.04"/>
      </geometry>
      <material name="iphone_gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.065 0 0.02" rpy="1.57 0 0"/>
      <geometry>
        <box size="0.3 0.13 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  
  <link name="tool_tip_link"/>
  
  <joint name="wrist_3_to_tool" type="fixed">
    <!-- Tool attached to wrist_3_link with offset [-0.08, 0, 0] from valid8_setup.yaml attach_pose -->
    <origin xyz="-0.08 0 0.05" rpy="1.57 0 0"/>
    <parent link="wrist_3_link"/>
    <child link="tool_base_link"/>
  </joint>
  
  <joint name="tool_base_to_tip" type="fixed">
    <parent link="tool_base_link"/>
    <child link="tool_tip_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
</robot>
