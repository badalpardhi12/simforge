# MoveRobot Action
# Execute robot motion with collision checking via cuMotion

# === GOAL ===

# Robot identifier (e.g., "ur20_1", "ur5e_2")
string robot_name

# Reference frame (e.g., "world", "robot_base", "tool0")
string reference_frame

# Motion type
uint8 MOTION_TYPE_JOINT = 0
uint8 MOTION_TYPE_CARTESIAN = 1
uint8 MOTION_TYPE_TRAJECTORY = 2
uint8 motion_type

# Target pose (for CARTESIAN motion)
geometry_msgs/Pose target_pose

# Target joints (for JOINT motion) - 6 values for 6-DOF
float64[] target_joints

# Pre-planned trajectory (for TRAJECTORY motion)
trajectory_msgs/JointTrajectory trajectory

# Velocity and acceleration scaling (0.0 to 1.0)
float64 velocity_scale
float64 acceleration_scale

# Optional: text prompt for VLA-guided motion
string text_prompt

# Enable collision checking via cuMotion
bool collision_check_enabled

# Timeout for planning (seconds)
float64 planning_timeout

# Allow replanning if obstacles detected
bool allow_replanning

---

# === RESULT ===

# Success flag
bool success

# Status message
string message

# Final joint positions at completion
float64[] final_joint_positions

# Final TCP pose at completion
geometry_msgs/Pose final_pose

# Execution metrics
float64 execution_time_sec
float64 planning_time_sec
float64 trajectory_length_m

# Number of replans performed (if allow_replanning was true)
uint32 replan_count

---

# === FEEDBACK ===

# Progress (0.0 to 1.0)
float32 progress

# Current joint positions
float64[] current_joint_positions

# Current TCP pose
geometry_msgs/Pose current_pose

# Current status
# "planning", "executing", "replanning", "collision_detected", "completed"
string status

# Distance to goal (meters for Cartesian, radians for joint)
float64 distance_to_goal

# Estimated time remaining (seconds)
float64 time_remaining
