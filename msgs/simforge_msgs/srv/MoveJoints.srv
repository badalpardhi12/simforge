# MoveJoints Service
# Move robot to specified joint positions

# Request
float64[] joint_positions  # 6 joint values in radians
float64 velocity           # Joint velocity (rad/s), default 1.05
float64 acceleration       # Joint acceleration (rad/s^2), default 1.4
bool wait_for_completion   # Whether to block until motion completes

---
# Response
bool success               # Whether the motion was initiated/completed successfully
string message             # Status message
