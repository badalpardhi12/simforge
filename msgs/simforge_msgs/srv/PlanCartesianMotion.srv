# PlanCartesianMotion Service
# Plan a collision-free trajectory from current pose to target Cartesian pose
# Uses cuMotion on Jetson or trac_ik fallback on x86

# === REQUEST ===

# Robot identifier (e.g., "nakul_ur5e")
string robot_name

# Target pose in specified reference frame
geometry_msgs/Pose target_pose

# Reference frame for target_pose (e.g., "world", "base_link", "face_link")
string reference_frame

# Starting joint configuration (optional, uses current if empty)
float64[] start_joints

# Motion constraints
float64 velocity_scale  # 0.0 to 1.0, default 0.3
float64 acceleration_scale  # 0.0 to 1.0, default 0.3

# Planning parameters
float64 planning_timeout  # seconds, default 5.0
bool collision_check_enabled  # default true

# nvblox integration (ignored if unavailable)
bool use_nvblox_esdf  # Use real-time ESDF for collision checking
string nvblox_costmap_topic  # default: /nvblox/combined_esdf

---

# === RESPONSE ===

# Planning success
bool success

# Status message
string message

# Planned trajectory (empty if failed)
trajectory_msgs/JointTrajectory trajectory

# IK solution for target pose (empty if IK failed)
float64[] target_joints

# Planning metrics
float64 planning_time_sec
float64 trajectory_duration_sec
float64 trajectory_length_m

# IK solver used: "cumotion", "trac_ik", "kdl", "none"
string ik_solver_used

# Collision check result
bool collision_free
uint32 num_collision_checks
