# VLA Action Request Service
# Query the Vision-Language-Action model for manipulation actions

# === REQUEST ===

# Current camera image (RGB)
sensor_msgs/Image image

# Natural language instruction
string instruction

# Optional: specific object classes to attend to
string[] object_classes

# Optional: current robot state for context
float64[] current_joint_positions

# Optional: reference frame for output poses
string reference_frame

---

# === RESPONSE ===

# Success flag
bool success

# Error message if failed
string error_message

# Sequence of waypoint poses (in reference_frame)
geometry_msgs/Pose[] waypoint_poses

# Action labels for each waypoint (e.g., "approach", "grasp", "lift")
string[] action_labels

# Confidence scores for each waypoint (0.0 to 1.0)
float32[] confidence_scores

# Gripper actions for each waypoint (-1.0=open, 1.0=close, 0.0=no change)
float32[] gripper_actions

# Timing hints (optional, seconds between waypoints)
float32[] timing_hints

# Inference performance
float32 inference_time_ms
string model_name
