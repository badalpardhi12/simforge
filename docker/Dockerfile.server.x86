# Simforge Server Docker Configuration for x86 AI Workstation (Development)
# 
# This Dockerfile sets up the ROS 2 Humble environment with:
# - CUDA 12.4 support for GPU acceleration
# - Foxglove Bridge for Mac client communication
# - ur_rtde for UR robot control
# - Placeholder for Isaac ROS packages (cuMotion, nvblox)

FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

LABEL maintainer="badal@example.com"
LABEL description="Simforge Server - ROS 2 Humble with GPU support"
LABEL version="1.0.0"

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Set locale
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8

# Install essential packages
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    gnupg \
    lsb-release \
    wget \
    git \
    cmake \
    build-essential \
    python3-pip \
    python3-dev \
    python3-venv \
    libboost-all-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Add ROS 2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key | apt-key add - && \
    sh -c 'echo "deb http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2-latest.list'

# Install ROS 2 Humble
RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-rclpy \
    ros-humble-std-msgs \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-trajectory-msgs \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-control-msgs \
    ros-humble-visualization-msgs \
    ros-humble-nav-msgs \
    ros-humble-foxglove-bridge \
    ros-humble-moveit \
    ros-humble-robot-state-publisher \
    ros-humble-joint-state-publisher \
    ros-humble-joint-state-publisher-gui \
    ros-humble-xacro \
    ros-humble-urdf \
    python3-colcon-common-extensions \
    ros-humble-moveit-planners \
    ros-humble-moveit-ros-planning-interface \
    ros-humble-moveit-servo \
    ros-humble-moveit-setup-assistant \
    ros-humble-moveit-configs-utils \
    ros-humble-ament-cmake-python \
    python3-colcon-common-extensions \
    python3-rosdep \
    ros-humble-kdl-parser \
    && rm -rf /var/lib/apt/lists/*

# Install Universal Robots ROS 2 Driver and dependencies
RUN apt-get update && apt-get install -y \
    ros-humble-ur-robot-driver \
    ros-humble-ur-description \
    ros-humble-ur-moveit-config \
    ros-humble-ur-calibration \
    ros-humble-controller-manager \
    ros-humble-joint-state-broadcaster \
    ros-humble-joint-trajectory-controller \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    && rm -rf /var/lib/apt/lists/*

# Install trac_ik from source (not available as apt package for Humble)
RUN apt-get update && apt-get install -y \
    libnlopt-dev \
    libnlopt-cxx-dev \
    liborocos-kdl-dev \
    python3-pykdl \
    && rm -rf /var/lib/apt/lists/*

# Initialize rosdep
RUN rosdep init || true && rosdep update

# Install ur_rtde from PPA
RUN add-apt-repository ppa:sdurobotics/ur-rtde && \
    apt-get update && apt-get install -y \
    librtde \
    librtde-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    websockets>=12.0 \
    asyncio \
    numpy>=1.24.0 \
    scipy>=1.10.0 \
    transforms3d>=0.4.1 \
    pyyaml>=6.0 \
    opencv-python>=4.8.0 \
    pyrealsense2>=2.54.0 \
    ur_rtde>=1.5.0 \
    foxglove-websocket>=0.1.0

# Create workspace directory
WORKDIR /ros2_ws

# Copy package source - Messages first
COPY msgs /ros2_ws/src/msgs

# Copy Valid8 Cell packages (proper UR + MoveIt integration)
COPY valid8_cell_description /ros2_ws/src/valid8_cell_description
COPY valid8_cell_control /ros2_ws/src/valid8_cell_control
COPY valid8_cell_moveit_config /ros2_ws/src/valid8_cell_moveit_config

# Copy Simforge Server (application layer)
COPY simforge_server /ros2_ws/src/simforge_server
COPY config /ros2_ws/src/simforge_server/config
COPY assets /ros2_ws/src/simforge_server/assets

# Also copy assets to root level for easy access
COPY assets /ros2_ws/assets

# Build ROS 2 packages in dependency order
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    cd /ros2_ws && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --packages-select simforge_msgs valid8_cell_description valid8_cell_control valid8_cell_moveit_config simforge_server"

# Setup entrypoint
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

# Environment variables
ENV ROS_DOMAIN_ID=42
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Expose ports
# Foxglove Bridge WebSocket
EXPOSE 9090
# Custom Command Gateway WebSocket
EXPOSE 8765
# ROS 2 DDS ports
EXPOSE 7400-7500/udp

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
